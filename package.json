{
  "name": "pii-evidence",
  "private": true,
  "type": "module",
  "description": "Scanner-neutral public PII/PHI evidence: schemas, validation, and snapshots.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lint:privacy-data": "node scripts/lint-safe-data.mjs",
    "lint:safe-data": "npm run lint:privacy-data",
    "lint:credentials": "node scripts/lint-credentials.mjs",
    "lint:provenance": "node scripts/lint-provenance.mjs",
    "fixtures:materialize": "node scripts/materialize-fixtures.mjs",
    "fixtures:materialize:check": "node scripts/materialize-fixtures.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run validate && npm run lint:privacy-data && npm run lint:credentials && npm run lint:provenance && npm run fixtures:materialize:check && npm run snapshot:verify && npm run snapshot:delta:check && npm test",
    "snapshot:build": "node scripts/snapshot.mjs build",
    "snapshot:verify": "node scripts/snapshot.mjs verify",
    "snapshot:delta": "node scripts/snapshot-delta.mjs",
    "snapshot:delta:check": "node scripts/snapshot-delta.mjs --check"
  },
  "devDependencies": {
    "@redact-secret/core": "0.1.0-beta.14",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
