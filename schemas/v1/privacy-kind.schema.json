{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redact-secret/pii-evidence/schemas/v1/privacy-kind.schema.json",
  "title": "PrivacyKind (v1)",
  "description": "A structured privacy concept (ARCHITECTURE.md section 4). One entry of the kinds[] array in taxonomy/privacy-kinds.json. Domain membership is not identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "domains", "jurisdictions", "classification", "formatClaims", "contextClaims", "openQuestions"],
  "properties": {
    "id": { "$ref": "defs.schema.json#/$defs/id" },
    "label": { "$ref": "defs.schema.json#/$defs/text" },
    "domains": { "$ref": "defs.schema.json#/$defs/domains" },
    "baseKind": { "description": "Id of the kind this one specializes; absent for base kinds.", "$ref": "defs.schema.json#/$defs/id" },
    "jurisdictions": { "allOf": [{ "$ref": "defs.schema.json#/$defs/idList" }, { "type": "array", "minItems": 1 }] },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidenceClass"],
      "properties": {
        "state": { "enum": ["resolved", "unresolved"] },
        "evidenceClass": { "$ref": "defs.schema.json#/$defs/evidenceClass" }
      }
    },
    "formatClaims": { "description": "Ids of Claim records that state the format of this kind. Empty until sources exist.", "$ref": "defs.schema.json#/$defs/idList" },
    "contextClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "effect", "evidenceClass"],
        "properties": {
          "context": { "$ref": "defs.schema.json#/$defs/id" },
          "effect": { "enum": ["adds-domain", "supports-identification"] },
          "domains": { "$ref": "defs.schema.json#/$defs/domains" },
          "evidenceClass": { "$ref": "defs.schema.json#/$defs/evidenceClass" },
          "claims": { "description": "Ids of Claim records backing this context claim.", "$ref": "defs.schema.json#/$defs/idList" }
        },
        "if": { "properties": { "effect": { "const": "adds-domain" } }, "required": ["effect"] },
        "then": { "required": ["domains"], "properties": { "domains": true } }
      }
    },
    "openQuestions": { "$ref": "defs.schema.json#/$defs/textList" }
  }
}
